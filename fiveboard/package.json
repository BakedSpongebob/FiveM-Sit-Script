{
  "name": "fiveboard",
  "productName": "FiveBoard",
  "version": "1.0.0",
  "description": "A planning board and code space for FiveM scripting: notes, images, files and whole resources on one canvas, connected with yarn.",
  "main": "src/main/main.js",
  "type": "module",
  "author": "BakedSpongebob",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/BakedSpongebob/FiveM-Sit-Script.git",
    "directory": "fiveboard"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --mac --publish never",
    "dist:dir": "electron-builder --dir --publish never"
  },
  "dependencies": {
    "codemirror": "^5.65.21"
  },
  "devDependencies": {
    "electron": "^44.1.0",
    "electron-builder": "~26.17.0"
  },
  "build": {
    "appId": "com.fiveboard.app",
    "productName": "FiveBoard",
    "copyright": "MIT License",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "fiveboard",
        "name": "FiveBoard Board",
        "role": "Editor"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "identity": "-",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "FiveBoard"
    }
  }
}
